{
  "$comment": "chat2 sync protocol conformance vectors. Every implementation of the chat2 client runs these: Rust (crates/sync, chat2_vectors test), Swift (apps/ios, Chat2VectorTests). A new port (for example Zig) adds a runner against this same file. Expected values are the protocol, not one implementation: change them only together with every runner.",
  "frameTypes": {
    "hello": 1,
    "state": 2,
    "rowsReq": 3,
    "row": 4,
    "rowsDone": 5,
    "push": 6,
    "ack": 7,
    "presence": 8,
    "probe": 9,
    "probeOk": 10,
    "error": 11
  },
  "maxHeaderBytes": 4096,
  "encode": [
    {
      "name": "hello with cursor and device",
      "kind": 1,
      "header": {
        "cursor": 42,
        "device": "phone-1"
      },
      "payloadHex": "",
      "bytesHex": "01200000007b22637572736f72223a34322c22646576696365223a2270686f6e652d31227d"
    },
    {
      "name": "push with batch id and update bytes",
      "kind": 6,
      "header": {
        "batchId": "b1"
      },
      "payloadHex": "090807",
      "bytesHex": "06100000007b2262617463684964223a226231227d090807"
    },
    {
      "name": "row with seq and payload",
      "kind": 4,
      "header": {
        "seq": 7
      },
      "payloadHex": "01020304",
      "bytesHex": "04090000007b22736571223a377d01020304"
    },
    {
      "name": "rows done",
      "kind": 5,
      "header": {
        "headSeq": 12
      },
      "payloadHex": "",
      "bytesHex": "050e0000007b2268656164536571223a31327d"
    },
    {
      "name": "state from the server",
      "kind": 2,
      "header": {
        "checkpointSeq": 3,
        "checkpointSize": 160000,
        "headSeq": 10,
        "rowBytes": 14000,
        "rowCount": 7,
        "seqFloor": 3
      },
      "payloadHex": "",
      "bytesHex": "02630000007b22636865636b706f696e74536571223a332c22636865636b706f696e7453697a65223a3136303030302c2268656164536571223a31302c22726f774279746573223a31343030302c22726f77436f756e74223a372c22736571466c6f6f72223a337d"
    },
    {
      "name": "empty header, empty payload",
      "kind": 9,
      "header": {},
      "payloadHex": "",
      "bytesHex": "09020000007b7d"
    },
    {
      "name": "error: a push over the chat's quota, with the time left in the window",
      "kind": 11,
      "header": {
        "batchId": "b7",
        "code": "quota",
        "message": "push quota exceeded for this chat",
        "retryAfterMs": 4200
      },
      "payloadHex": "",
      "bytesHex": "0b610000007b2262617463684964223a226237222c22636f6465223a2271756f7461222c226d657373616765223a22707573682071756f746120657863656564656420666f7220746869732063686174222c22726574727941667465724d73223a343230307d"
    }
  ],
  "decodeRejects": [
    {
      "name": "empty",
      "bytesHex": ""
    },
    {
      "name": "type byte only",
      "bytesHex": "01"
    },
    {
      "name": "four of the five prefix bytes",
      "bytesHex": "01020000"
    },
    {
      "name": "header length past the end",
      "bytesHex": "010f2700007b7d"
    },
    {
      "name": "header is not an object",
      "bytesHex": "01030000005b315d"
    },
    {
      "name": "header longer than maxHeaderBytes",
      "bytesHex": ""
    }
  ],
  "decodeAccepts": [
    {
      "name": "unknown type byte is kept for the client to skip (the server rejects it)",
      "bytesHex": "7f070000007b2278223a317d",
      "kind": 127,
      "header": {
        "x": 1
      },
      "payloadHex": "",
      "clientOnly": true
    },
    {
      "name": "payload after the header is opaque",
      "bytesHex": "04090000007b22736571223a317d00ff10",
      "kind": 4,
      "header": {
        "seq": 1
      },
      "payloadHex": "00ff10"
    }
  ],
  "catchUp": [
    {
      "name": "no checkpoint: rows after the cursor",
      "cursor": 4,
      "state": {
        "headSeq": 10,
        "checkpointSeq": 0,
        "checkpointSize": 0
      },
      "frontierContained": false,
      "expect": {
        "plan": "rowsOnly",
        "after": 4
      }
    },
    {
      "name": "contained checkpoint ahead of the cursor: skip to it",
      "cursor": 2,
      "state": {
        "headSeq": 10,
        "checkpointSeq": 6,
        "checkpointSize": 100
      },
      "frontierContained": true,
      "expect": {
        "plan": "rowsOnly",
        "after": 6
      }
    },
    {
      "name": "contained checkpoint behind the cursor: keep the cursor",
      "cursor": 8,
      "state": {
        "headSeq": 10,
        "checkpointSeq": 6,
        "checkpointSize": 100
      },
      "frontierContained": true,
      "expect": {
        "plan": "rowsOnly",
        "after": 8
      }
    },
    {
      "name": "frontier missing: fetch the checkpoint, rows after it",
      "cursor": 2,
      "state": {
        "headSeq": 10,
        "checkpointSeq": 6,
        "checkpointSize": 100
      },
      "frontierContained": false,
      "expect": {
        "plan": "checkpointThenRows",
        "after": 6
      }
    },
    {
      "name": "cursor ahead of the server: the server lost state, start fresh",
      "cursor": 20,
      "state": {
        "headSeq": 10,
        "checkpointSeq": 0,
        "checkpointSize": 0
      },
      "frontierContained": false,
      "expect": {
        "plan": "rowsOnly",
        "after": 0
      }
    },
    {
      "name": "seeded room: checkpoint at seq 0 still counts (size, not seq)",
      "cursor": 0,
      "state": {
        "headSeq": 0,
        "checkpointSeq": 0,
        "checkpointSize": 5000
      },
      "frontierContained": false,
      "expect": {
        "plan": "checkpointThenRows",
        "after": 0
      }
    },
    {
      "name": "cursor equal to headSeq is not ahead",
      "cursor": 10,
      "state": {
        "headSeq": 10,
        "checkpointSeq": 0,
        "checkpointSize": 0
      },
      "frontierContained": false,
      "expect": {
        "plan": "rowsOnly",
        "after": 10
      }
    }
  ],
  "rowCursor": {
    "$comment": "The contiguity rule for each ROW (and own-push ACK): the cursor claims every row up to it is in the doc, so it only walks. seq <= cursor + 1 moves it to max(cursor, seq); a larger seq is a gap: the bytes are still imported, the cursor holds and a backfill repair is requested. An implementation may import a contiguous run in one batch (iOS does) as long as these per-row cursors come out the same.",
    "cases": [
      {
        "name": "contiguous rows walk the cursor",
        "cursor": 3,
        "steps": [
          {
            "seq": 4,
            "cursor": 4,
            "gap": false
          },
          {
            "seq": 5,
            "cursor": 5,
            "gap": false
          },
          {
            "seq": 6,
            "cursor": 6,
            "gap": false
          }
        ]
      },
      {
        "name": "own and replayed rows at or below the cursor leave it",
        "cursor": 5,
        "steps": [
          {
            "seq": 2,
            "cursor": 5,
            "gap": false
          },
          {
            "seq": 5,
            "cursor": 5,
            "gap": false
          },
          {
            "seq": 6,
            "cursor": 6,
            "gap": false
          }
        ]
      },
      {
        "name": "a gap holds the cursor; later contiguous rows still walk",
        "cursor": 3,
        "steps": [
          {
            "seq": 4,
            "cursor": 4,
            "gap": false
          },
          {
            "seq": 7,
            "cursor": 4,
            "gap": true
          },
          {
            "seq": 5,
            "cursor": 5,
            "gap": false
          },
          {
            "seq": 6,
            "cursor": 6,
            "gap": false
          },
          {
            "seq": 7,
            "cursor": 7,
            "gap": false
          },
          {
            "seq": 8,
            "cursor": 8,
            "gap": false
          }
        ]
      },
      {
        "name": "first row after a fresh start",
        "cursor": 0,
        "steps": [
          {
            "seq": 1,
            "cursor": 1,
            "gap": false
          },
          {
            "seq": 2,
            "cursor": 2,
            "gap": false
          }
        ]
      },
      {
        "name": "first row missing on a fresh start is a gap",
        "cursor": 0,
        "steps": [
          {
            "seq": 2,
            "cursor": 0,
            "gap": true
          },
          {
            "seq": 1,
            "cursor": 1,
            "gap": false
          },
          {
            "seq": 2,
            "cursor": 2,
            "gap": false
          }
        ]
      },
      {
        "name": "a duplicate of the next row is harmless",
        "cursor": 9,
        "steps": [
          {
            "seq": 10,
            "cursor": 10,
            "gap": false
          },
          {
            "seq": 10,
            "cursor": 10,
            "gap": false
          },
          {
            "seq": 11,
            "cursor": 11,
            "gap": false
          }
        ]
      }
    ]
  }
}
