{
  "about": "The cloud sandbox contract the desktop engine, the iOS app and the Android app share. The phones talk to the Codegraff gateway directly with a gateway key; this file pins what they send, how they read what comes back, and the words they show. Desktop is the reference: change a rule there and this file must change with it.",
  "gateway": "https://gateway.codegraff.com",
  "signIn": {
    "start": {
      "method": "POST",
      "path": "/v1/device/start",
      "body": {
        "device_label": "{deviceLabel}"
      },
      "deviceLabels": {
        "desktop": "harness-desktop",
        "ios": "harness-ios",
        "android": "harness-android"
      }
    },
    "poll": {
      "method": "POST",
      "path": "/v1/device/poll",
      "body": {
        "device_code": "{deviceCode}"
      }
    },
    "pollMessages": {
      "denied": "Sign-in was denied in the browser.",
      "expired": "The sign-in link expired. Try again.",
      "consumed": "This sign-in was already used. Try again.",
      "not_found": "Codegraff lost this sign-in. Try again."
    }
  },
  "stateWords": {
    "started": "running",
    "running": "running",
    "starting": "starting",
    "paused": "paused",
    "stopping": "stopping",
    "error": "error",
