  "plans": {
    "createTemporary": [
      {
        "method": "POST",
        "path": "/v1/sandboxes",
        "body": {
          "provider": "auto",
          "ephemeral": true,
          "name": "Temporary sandbox",
          "autoStopMinutes": 30,
          "labels": { "harness-purpose": "temporary" }
        }
      }
    ],
    "create": [
      {
        "method": "GET",
        "path": "/v1/sandboxes/personal-sizes"
      },
      {
        "method": "POST",
        "path": "/v1/sandboxes",
        "body": {
          "provider": "fleet",
          "persistent": true,
          "name": "Harness cloud",
          "autoStopMinutes": 30,
          "keepRunning": true
        }
      },
      {
        "method": "POST",
        "path": "/v1/sandboxes/{id}/harness",
        "body": {
          "deviceName": "{deviceName}"
        }
      }
    ],
    "createLarge": [
      {
        "method": "GET",
        "path": "/v1/sandboxes/personal-sizes"
      },
      {
        "method": "POST",
        "path": "/v1/sandboxes",
        "body": {
          "provider": "fleet",
          "persistent": true,
          "name": "Harness cloud",
          "autoStopMinutes": 30,
          "keepRunning": true,
          "cpu": 4,
          "memory": 8,
          "disk": 40
        }
      },
      {
        "method": "POST",
        "path": "/v1/sandboxes/{id}/harness",
        "body": {
          "deviceName": "{deviceName}"
        }
      }
    ],
    "startWhenPaused": [
      {
        "method": "GET",
        "path": "/v1/sandboxes/{id}"
      },
      {
        "method": "POST",
        "path": "/v1/sandboxes/{id}/start",
        "body": {
          "leaseSeconds": 1800,
          "keepRunning": true
        }
      },
      {
        "method": "POST",
        "path": "/v1/sandboxes/{id}/harness",
        "body": {
          "deviceName": "{deviceName}"
        }
      }
    ],
    "startWhenRunning": [
      {
        "method": "GET",
        "path": "/v1/sandboxes/{id}"
      },
      {
        "method": "POST",
        "path": "/v1/sandboxes/{id}/harness",
        "body": {
          "deviceName": "{deviceName}"
        }
      }
    ],
    "stop": [
      {
        "method": "POST",
        "path": "/v1/sandboxes/{id}/stop"
      }
    ],
    "keepRunningOn": [
      {
        "method": "POST",
        "path": "/v1/sandboxes/{id}/keep-running",
        "body": {
          "enabled": true
        }
      }
    ],
    "keepRunningOff": [
      {
        "method": "POST",
        "path": "/v1/sandboxes/{id}/keep-running",
        "body": {
          "enabled": false
        }
      }
    ],
    "delete": [
      {
        "method": "DELETE",
        "path": "/v1/sandboxes/{id}"
      }
    ],
    "retry": "A /harness call that fails with error type harness_start_failed is repeated once; nothing else is retried.",
    "neverCalled": [
      "/codegraff"
    ],
    "sizesNote": "A create first reads GET /v1/sandboxes/personal-sizes. The create body adds cpu, memory and disk (GiB) of the chosen size (the default one when none is picked). When that read fails (404 on gateways without sizes), the create body is exactly as before: no cpu, memory or disk. createLarge is the call sequence for size id \"large\" with personalSizes above; create is the sequence against a gateway whose personal-sizes answers 404."
  },
